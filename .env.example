# demo = deterministic word hashing + copied evidence, NO AI model calls.
# openai = real embedding and generation calls (billed to your API account).
RAG_MODE=demo
SQLITE_PATH=demo.sqlite3
# Set DATABASE_URL to choose PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://rag:rag-local-only@localhost:5432/rag
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_WORDS=120
CHUNK_OVERLAP=20
MIN_SCORE=0.25

